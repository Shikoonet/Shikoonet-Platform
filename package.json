{
  "name": "shikoo-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Shikoo platform — Telegram commerce bot, bank-SMS payment verification, and product provisioning on one Postgres.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail test",
    "build": "pnpm -r --parallel build",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,sql}\"",
    "sim:up": "docker compose -f sim/docker-compose.yml up -d",
    "sim:down": "docker compose -f sim/docker-compose.yml down -v",
    "sim:panel": "node sim/fake-panel.mjs"
  },
  "dependencies": {
    "tsx": "^4.23.7"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "2.1.4"
  }
}
