node_modules

# Playwright MCP scratch output (screenshots, page snapshots)
.playwright-mcp/

# graphify's generated index and cache. Regenerated from the source it describes,
# so committing it adds nothing and costs a great deal: 78 files and 168k lines
# swept into one deploy commit by `git add -A`, one of them a cache whose hashes
# gitleaks reads as secrets — which is how it was noticed.
graphify-out/
dist
build
coverage
test-results
playwright-report
*.tsbuildinfo

# Local env / secrets — never committed
.env
.env.*
!.env.example
sim/.env.local

# Production data — customer payments, Telegram IDs, card numbers
legacy/mirzabot-php/db/
*.sql.gz

# `legacy/` IS tracked, from 2026-08-29 — Sam's decision. It is the behaviour
# reference for the rewrite, and a reference nobody else can read is not one.
#
# Each of the four sub-directories used to carry its own `.git`, which git would
# have recorded as an unusable gitlink — a folder that renders empty on GitHub.
# Those histories were copied to `.notes/legacy-git/`, verified byte-for-byte and
# by HEAD, and only then removed. `.notes/legacy-git/README.md` has each one's
# HEAD, branch and remote.
#
# Two things inside it stay out, and the rules are above and below this line:
# `legacy/mirzabot-php/db/` (real customer payments) and any `graphify-out/`.
legacy/hub-cloudflare/graphify-out/

# The D1 export of the Cloudflare production database — `device_credentials`,
# `payment_claims`, receipts. `legacy/hub-cloudflare/.gitignore` already excludes
# it, and that file is now tracked, which means one careless edit to it would put
# real customer data in the index. Stated here too, where the rest of the
# never-commit rules live, so removing one is not enough.
legacy/hub-cloudflare/.production-backups/

# The real bank receipt Sam supplied on 2026-08-24 for the layout test.
#
# It carries a customer's name, both card numbers and the bank reference, and a
# repository remembers a file long after it is deleted — so it lives on disk and
# never in history. Sam's decision, 2026-08-24.
#
# Nothing depends on it: `e2e/fixtures/receipt-portrait.svg` is a drawn copy at
# the same 591×1280, and every assertion in `money-layout.spec.ts` is about size.
apps/dashboard-worker/e2e/fixtures/*.local.*

# Deployment credentials. These live on the server at /etc/shikoo/*.env, 0600
# root, and the only reason this rule exists is the other case: somebody copies
# one into the checkout to read it, and `git add -A` takes it. `.env.*` above
# does not cover `autodeploy.env`.
deploy/*.env
deploy/**/*.env
*.env
!*.env.example

# Machine-readable test reports. Written by every CI shard (vitest) and by the
# browser walk (playwright), uploaded as artifacts, and read back by
# `tools/ci-verify-gate.ts` in the Required Quality Gate. Never committed —
# the numbers that ARE committed live in `.github/ci-baseline.json`.
vitest-report.json
playwright-report.json

# Mirzabot dumps staged for «ایمپورت». Real customer money and Telegram ids, and
# the file carries plaintext panel passwords -- the same reason `legacy/**/db/`
# is ignored. On the server this is `IMPORT_DIR` and lives outside the repo.
.tmp-imports/
