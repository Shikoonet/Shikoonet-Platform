#!/usr/bin/env python3
"""A curl that answers the GitHub calls this rehearsal makes, and nothing else."""
import json
import os
import sys
import zipfile

argv = sys.argv[1:]

if "--version" in argv:
    sys.stdout.write("curl 8.5.0 (x86_64-fake)\n")
    sys.stdout.write("Protocols: file ftp http https\n")
    sys.exit(0)

url = argv[-1]
outfile = None
for i, a in enumerate(argv):
    if a == "-o" and i + 1 < len(argv):
        outfile = argv[i + 1]

SHA = os.environ["FAKE_MAIN_SHA"]
DIGEST = os.environ["FAKE_DIGEST"]
STATUS = os.environ.get("FAKE_GH_STATUS", "200")

# The FULL argv, not just the URL's last segment.
#
# `rehearsal-cleanup.test.sh` greps this log for the token and says "if the
# token were in argv anywhere, it would be in this log". With only a path
# segment recorded that claim was false: a `-H "Authorization: bearer <token>"`
# argument would never have reached the log, and the credential-leak assertion
# would have passed with the token sitting in argv.
with open(os.environ["FAKE_LOG"], "a", encoding="utf-8") as fh:
    fh.write("curl||" + " ".join(argv).replace("\n", " ") + "|" + STATUS + "\n")

if outfile:
    import hashlib
    man = (
        "schema_version=1\n"
        "repository=Shikoonet/Shikoonet-Platform\n"
        f"main_sha={SHA}\n"
        f"digest={DIGEST}\n"
        f"image_ref=ghcr.io/shikoonet/shikoonet-platform@{DIGEST}\n"
        "approval_policy=solo-owner\n"
        "ci_run_id=9002\n"
        "staging_run_id=9001\n"
        "staging_bot_id=not-deployed\n"
    )
    with zipfile.ZipFile(outfile, "w") as z:
        z.writestr("manifest.env", man)
        z.writestr("manifest.sha256",
                   hashlib.sha256(man.encode()).hexdigest() + "  manifest.env\n")
    sys.stdout.write(STATUS)
    sys.exit(0)

if "commits/main" in url:
    body = json.dumps({"sha": SHA})
elif "deploy-staging.yml/runs" in url:
    body = json.dumps({"workflow_runs": [
        {"id": 9001, "head_sha": SHA, "head_branch": "main", "status": "completed",
         "conclusion": "success", "event": "push",
         "updated_at": "2026-08-20T00:00:00Z", "created_at": "2026-08-20T00:00:00Z"}]})
elif "ci.yml/runs" in url:
    body = json.dumps({"workflow_runs": [
        {"id": 9002, "head_sha": SHA, "head_branch": "main", "status": "completed",
         "conclusion": "success", "event": "push"}]})
elif "/artifacts" in url:
    body = json.dumps({"artifacts": [
        {"name": "staging-digest", "expired": False,
         "archive_download_url": "https://api.github.com/dl/staging-digest"}]})
else:
    body = "{}"

sys.stdout.write(body + STATUS)
