# Ingest: the only surface the outside world posts to, on 8787.
#
# Two inbound routes — `POST /api/v1/sms` from the Android SMS-relay phones, and
# the HMAC-signed Mirzabot claims endpoint. It also runs the scheduled sweep
# that expires claims and re-matches transactions.
#
# Binds 127.0.0.1; TLS and the first layer of rate limiting belong to the edge
# (nginx or a Cloudflare Tunnel). The second layer is in the app — rateLimit.ts.
#
# The Android app's contract is frozen. Only the URL in its settings changes.
#
#   systemctl enable --now shikoo-ingest

[Unit]
Description=Shikoo SMS ingest
Documentation=file:///opt/shikoo/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shikoo
Group=shikoo
WorkingDirectory=/opt/shikoo/ingest
# DATABASE_URL plus the Mirzabot integration secrets. In production the process
# refuses to start unless MIRZABOT_INTEGRATION_ENABLED and AUTO_MATCH_ENABLED
# have both been decided — absent, they mean off, and off looks exactly like
# working while no payment is ever verified.
EnvironmentFile=/etc/shikoo/ingest.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=shikoo-ingest

[Install]
WantedBy=multi-user.target
