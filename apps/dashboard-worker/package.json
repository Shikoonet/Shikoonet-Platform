{
  "name": "@shikoo/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src test e2e scripts --max-warnings 0",
    "test": "vitest run",
    "e2e": "corepack pnpm --filter @shikoo/admin-web build && playwright test",
    "operator": "tsx scripts/operator.ts",
    "verify-login": "tsx scripts/verifyLogin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@shikoo/contracts": "workspace:*",
    "@shikoo/database": "workspace:*",
    "@shikoo/db": "workspace:*",
    "@shikoo/domain": "workspace:*",
    "@shikoo/migrate": "workspace:*",
    "@shikoo/sms-parser": "workspace:*",
    "hono": "4.13.3",
    "tsx": "^4.23.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@shikoo/seed": "workspace:*",
    "@types/node": "^22.9.0",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
