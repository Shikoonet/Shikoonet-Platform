{
  "name": "@shikoo/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:local": "tsx --env-file=../../sim/.env.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "test": "vitest run",
    "panel:preflight": "tsx scripts/panel-preflight.ts",
    "panel:wire-test": "tsx --env-file=../../sim/.env.local scripts/wire-test-panel.ts"
  },
  "dependencies": {
    "@shikoo/contracts": "workspace:*",
    "@shikoo/database": "workspace:*",
    "@shikoo/db": "workspace:*",
    "@shikoo/domain": "workspace:*",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@shikoo/seed": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
